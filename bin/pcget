#!/usr/bin/env bash
source "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/_pc-common"
[[ $# == 2 && -n "$1" && -n "$2" && "$2" != '-' ]] || { echo 'Usage: pcget <pc-path> <local-path>   (prints the sha256 of what it copied)' >&2; exit 2; }
[[ ! -d "$2" ]] || { echo "pcget: $2 is a folder; give the full local file path" >&2; exit 2; }
printf -v remote '%q' "$1"
local_tmp=$(mktemp -- "$2.pcbridge.XXXXXX")
trap 'rm -f -- "$local_tmp"' EXIT
"${pcssh[@]}" "cat -- $remote" > "$local_tmp"
mv -f -- "$local_tmp" "$2"
# the hash lets pcput --expect-sha256 refuse to overwrite a file that changed on the PC in the meantime
sha256sum -- "$2" | cut -d' ' -f1 >&2
